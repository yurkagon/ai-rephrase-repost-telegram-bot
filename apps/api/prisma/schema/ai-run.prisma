model AiRun {
  id            String   @id @default(uuid())
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String
  options       Json
  durationMs    Int
  inputTokens   Int?
  outputTokens  Int?
  outcome       String
  createdAt     DateTime @default(now())
}
