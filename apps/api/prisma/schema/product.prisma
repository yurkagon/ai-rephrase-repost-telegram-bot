enum PostStatus {
  COLLECTING
  INBOX
  GENERATING
  DRAFT
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
  PUBLICATION_UNKNOWN
}
enum OperationKind {
  GENERATE
  PUBLISH
}
enum OperationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  UNKNOWN
}
model RefreshSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}
model AccountToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  hash String @unique
  expiresAt DateTime
  @@index([userId, kind])
}
model Channel {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chatId String @unique
  title String
  username String?
  canPublish Boolean
  createdAt DateTime @default(now())
  sources Route[] @relation("Source")
  targets Route[] @relation("Target")
  @@index([ownerId])
}
model Route {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceId String
  source Channel @relation("Source", fields: [sourceId], references: [id])
  targetId String
  target Channel @relation("Target", fields: [targetId], references: [id])
  name String
  active Boolean @default(true)
  options Json
  posts Post[]
  createdAt DateTime @default(now())
  @@unique([ownerId, sourceId, targetId])
}
model Post {
  id String @id @default(uuid())
  routeId String
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sourceKey String
  originalHtml String
  media PostMedia[]
  status PostStatus @default(INBOX)
  revision Int @default(0)
  revisions PostRevision[]
  operations Operation[]
  runs AiRun[]
  publishedIds Int[]
  error String?
  failureStage String?
  rating Int?
  lastReceivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@unique([routeId, sourceKey])
  @@index([routeId, createdAt])
  @@index([status, lastReceivedAt])
}
model PostMedia {
  id String @id @default(uuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  messageId Int
  type String
  fileId String
  originalCaption String
  @@unique([postId, messageId])
}
model PostRevision {
  id String @id @default(uuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  version Int
  origin String
  html String
  captions Json
  createdAt DateTime @default(now())
  @@unique([postId, version])
}
model Operation {
  id String @id @default(uuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind OperationKind
  status OperationStatus @default(PENDING)
  revision Int
  options Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([postId, kind, revision])
  @@index([status])
}
model AiRun {
  id String @id @default(uuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  model String
  promptVersion String
  options Json
  durationMs Int
  inputTokens Int?
  outputTokens Int?
  outcome String
  createdAt DateTime @default(now())
}
model DailyQuota {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope String
  day String
  used Int @default(0)
  @@unique([scope, day])
}
