# API runtime configuration is validated by Zod at startup.
NODE_ENV=development
PORT=3000
CLIENT_PORT=3001

# Local services started by `pnpm db:up`.
LOCAL_POSTGRES_PORT=5433
LOCAL_POSTGRES_DB=copywrite_repost_bot
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=postgres
LOCAL_REDIS_PORT=6380
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/copywrite_repost_bot"
REDIS_URL="redis://localhost:6380"

# Replace before using this project outside local development.
JWT_SECRET=replace-with-a-long-random-secret
# Required duration strings, at least 1 second (e.g. 2h / 7d).
JWT_EXPIRATION_TIME=15m
JWT_REFRESH_EXPIRATION_TIME=7d

# `pnpm db:seed` creates one SUPERADMIN user if this email does not exist.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=123456
SEED_USER_FIRST_NAME=Admin
SEED_USER_LAST_NAME=User

# Optional: comma-separated origins when the client is hosted separately.
# CORS_ORIGIN=https://example.com
# Optional: override the directory containing the client build.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist

# Telegram repost bot (runs with the API; both credentials are required).
TELEGRAM_BOT_API_TOKEN=
OPENAI_API_KEY=
LLM_MODEL=

# Public application URL (used in public auth Origin checks)
APP_URL=http://localhost:3001
